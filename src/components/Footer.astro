---
import { site, hours } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <p class="footer__title">Visit</p>
      <p>{site.address.street}<br />{site.address.suburb}, {site.address.state} {site.address.postcode}</p>
      <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
      <a class="footer__link" href={site.mapsUrl} target="_blank" rel="noopener">Get directions</a>
    </div>
    <div>
      <p class="footer__title">Hours</p>
      <dl class="footer__hours">
        {hours.map((h) => (<><dt>{h.day.slice(0, 3)}</dt><dd>{h.time}</dd></>))}
      </dl>
    </div>
    <div>
      <p class="footer__title">Explore</p>
      <ul>
        <li><a href={site.bookingUrl}>Make a booking</a></li>
        <li><a href="/treatments">Treatments</a></li>
        <li><a href="/gift">Buy a gift card</a></li>
        <li><a href="/find">Contact us</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__title">Info</p>
      <ul>
        <li><a href="/t-and-c">Terms &amp; Conditions</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        {site.instagram && <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>}
      </ul>
    </div>
  </div>
  <div class="wrap footer__base">
    <span>© {year} Chapel Cosmetics</span>
    <a href="https://thelocalfolk.com.au" target="_blank" rel="noopener">Site by The Local Folk</a>
  </div>
  <p class="footer__mark" aria-hidden="true">chapel cosmetics</p>
</footer>

<style>
  .footer { background: var(--burgundy); color: #f8e3e4; padding-top: clamp(56px, 7vw, 96px); overflow: hidden; }
  .footer a { color: #fff; text-decoration: none; }
  .footer a:hover { color: var(--blush); }
  .footer__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; font-size: 14px; }
  .footer__title { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--blush); margin-bottom: 16px; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .footer__link { border-bottom: 1px solid currentColor; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; }
  .footer__hours { display: grid; grid-template-columns: 48px 1fr; gap: 4px 12px; margin: 0; }
  .footer__hours dd { margin: 0; }
  .footer__base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 56px; padding-top: 20px; padding-bottom: 20px; border-top: 1px solid rgba(246,196,195,.25); font-size: 12px; letter-spacing: .06em; }
  .footer__mark { font-family: var(--serif); font-size: 12.4vw; line-height: .8; text-align: center; color: rgba(246,196,195,.16); margin: 16px 0 -0.12em; white-space: nowrap; letter-spacing: -0.03em; }
  @media (max-width: 820px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
