---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, hours, testimonials, focusAreas } from '../data/site';

const concerns = focusAreas.map((f) => ({ title: f.title, text: f.summary, href: `/treatments#${f.slug}`, label: f.label, image: f.image }));
const steps = [
  { n: 'Step 01', image: '/images/step-consult.jpg', tag: 'Consult', eyebrow: 'Start with a conversation', title: 'Your consult', text: 'Every treatment starts with a one-on-one chat about your skin, your concerns and the result you want. No pressure, just honest advice.', cta: 'Book a consult', href: site.bookingUrl },
  { n: 'Step 02', image: '/images/step-plan.jpg', tag: 'Your plan', eyebrow: 'Tailored to you', title: 'A plan that fits', text: 'Our team builds a treatment plan around you and explains exactly how and why it works, in plain language, so you always know what to expect.', cta: 'Explore treatments', href: '/treatments' },
  { n: 'Step 03', image: '/images/step-care.jpg', tag: 'Ongoing care', eyebrow: 'Every single visit', title: 'Consistent care', text: 'The same high standard every time, in a private, relaxed clinic on Chapel St. We track your progress and adjust as your skin changes.', cta: 'Meet the team', href: '/about' },
];
---
<Base>
  <section class="hero">
    <Photo src="/images/hero.jpg" alt="" label="Hero image" ratio="auto" class="hero__photo" eager />
    <div class="hero__content wrap">
      <p class="eyebrow">Cosmetic medicine · Prahran</p>
      <h1>Feel confident in <em>your own skin.</em></h1>
      <p>Nurse-led cosmetic medicine on Chapel St, focused on healthy, natural-looking skin quality. Every plan is tailored to you, with consistent care every visit.</p>
      <div class="hero__actions">
        <a class="btn btn--light" href={site.bookingUrl}>Book an appointment</a>
        <a class="btn btn--outline-light" href="/treatments">View treatments</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row-head">
        <h2>Our treatments</h2>
        <a class="link-arrow" href="/treatments">All treatments</a>
      </div>
      <ul class="tiles">
        {concerns.map((c) => (
          <li>
            <a href={c.href} class="tile">
              <Photo src={c.image} alt="" label={c.label} ratio="3 / 4" />
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap split">
      <Photo src="/images/team-together.jpg" alt="Claudia and Ellie at the Chapel Cosmetics reception" label="Claudia and Ellie in clinic" ratio="4 / 5" />
      <div class="split__text">
        <p class="eyebrow">Meet the team</p>
        <h2>A personal experience, <em>every single visit.</em></h2>
        <p>Chapel Cosmetics is home to cosmetic nurses Claudia and Ellie. Both share a gift for making clients feel safe and relaxed, and a commitment to explaining every treatment clearly, so you always know what's happening and why.</p>
        <a class="link-arrow" href="/about">Meet Claudia & Ellie</a>
      </div>
    </div>
  </section>

  <section class="section section--cream how">
    <div class="wrap">
      <div class="how__head">
        <p class="eyebrow">How it works</p>
        <h2>Your skin journey</h2>
      </div>
      <div class="journey">
        <div class="journey__media" aria-hidden="true">
          <div class="journey__frame">
            {steps.map((s, i) => (
              <div class:list={['journey__img', { 'is-active': i === 0 }]} data-i={i}>
                <Photo src={s.image} alt="" label={s.tag} ratio="1 / 1" />
              </div>
            ))}
            <span class="timeline__tag journey__tag">{steps[0].n}</span>
          </div>
        </div>
        <div class="journey__rail" aria-hidden="true">
          <span class="journey__fill"></span>
          <span class="journey__dot"></span>
        </div>
        <ol class="journey__steps">
          {steps.map((s, i) => (
            <li class:list={['journey__step', { 'is-active': i === 0 }]} data-i={i} data-tag={s.n}>
              <div class="journey__mobile-media">
                <Photo src={s.image} alt="" label={s.tag} ratio="1 / 1" />
                <span class="timeline__tag">{s.n}</span>
              </div>
              <div class="timeline__text">
                <p class="timeline__eyebrow">{s.eyebrow}</p>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <a class="pill" href={s.href}>{s.cta}</a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--blush quote">
    <div class="narrow">
      <p class="eyebrow">Client love</p>
      <blockquote>“{testimonials[0]}”</blockquote>
    </div>
  </section>

  <section class="section">
    <div class="wrap visit">
      <div>
        <p class="eyebrow">Visit us</p>
        <h2>{site.address.street}, {site.address.suburb}</h2>
        <p class="visit__lead">In the heart of Chapel St, Melbourne.</p>
        <dl class="visit__hours">
          {hours.map((h) => (<><dt>{h.day}</dt><dd>{h.time}</dd></>))}
        </dl>
        <div class="hero__actions">
          <a class="btn" href={site.bookingUrl}>Book now</a>
          <a class="btn btn--ghost" href={`tel:${site.phone.replace(/\s/g, '')}`}>Call {site.phoneDisplay}</a>
        </div>
      </div>
      <iframe class="visit__map" title="Map showing Chapel Cosmetics" src={site.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>

<script>
  const journey = document.querySelector<HTMLElement>('.journey');
  if (journey) {
    const steps = [...journey.querySelectorAll<HTMLElement>('.journey__step')];
    const imgs = [...journey.querySelectorAll<HTMLElement>('.journey__img')];
    const tag = journey.querySelector<HTMLElement>('.journey__tag');
    const rail = journey.querySelector<HTMLElement>('.journey__rail');
    let active = 0;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      steps.forEach((el, j) => el.classList.toggle('is-active', j === i));
      imgs.forEach((el, j) => el.classList.toggle('is-active', j === i));
      if (tag) tag.textContent = steps[i].dataset.tag ?? '';
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const mid = window.innerHeight / 2;
      let best = 0, bestDist = Infinity;
      steps.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      setActive(best);
      if (rail) {
        const r = rail.getBoundingClientRect();
        const dotY = mid + (window.innerWidth > 900 ? 62 : 0);
        const p = Math.min(1, Math.max(0, (dotY - r.top) / r.height));
        rail.style.setProperty('--p', p.toFixed(4));
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    .journey__img, .journey__step { transition: none; }
  }
  em { font-style: normal; color: var(--burgundy); }
  .center { text-align: center; }
  .hero { position: relative; display: grid; align-items: end; min-height: min(80vh, 760px); color: #fff; }
  .hero :global(.hero__photo) { position: absolute; inset: 0; aspect-ratio: auto; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(27,20,22,.55) 0%, rgba(27,20,22,.25) 45%, rgba(27,20,22,0) 75%), linear-gradient(0deg, rgba(27,20,22,.35), rgba(27,20,22,0) 50%); pointer-events: none; }
  .hero__content { position: relative; z-index: 1; width: 100%; padding-top: 80px; padding-bottom: clamp(48px, 8vw, 96px); }
  .hero__content > * { max-width: 620px; }
  .hero .eyebrow { color: rgba(255,255,255,.85); }
  .hero h1 { font-size: clamp(40px, 5.6vw, 76px); margin: 14px 0 20px; text-shadow: 0 2px 24px rgba(27,20,22,.2); }
  .hero h1 em { color: var(--burgundy); }
  .hero__content > p:not(.eyebrow) { font-size: 17px; color: rgba(255,255,255,.92); max-width: 480px; }
  .hero__actions .btn--outline-light { background: transparent; color: #fff; border-color: #fff; }
  .hero__actions .btn--outline-light:hover { background: #fff; color: var(--ink); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }

  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 32px; }
  .row-head h2, .split h2, .visit h2 { font-size: clamp(30px, 4vw, 46px); }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .tile { display: block; text-decoration: none; }
  .tile h3 { font-family: var(--sans); font-size: 15px; font-weight: 700; margin: 16px 0 4px; }
  .tile p { font-size: 14px; color: var(--ink-soft); margin: 0; }
  .tile :global(.photo) { transition: opacity .2s; }
  .tile:hover :global(.photo) { opacity: .85; }
  .tile:hover h3 { text-decoration: underline; text-underline-offset: 3px; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split__text h2 { margin: 14px 0 20px; }
  .split__text p:not(.eyebrow) { color: var(--ink-soft); max-width: 480px; margin-bottom: 28px; }

  .how__head { text-align: center; margin-bottom: clamp(40px, 6vw, 72px); }
  .how__head h2 { font-size: clamp(30px, 4vw, 46px); margin-top: 12px; }
  .journey { display: grid; grid-template-columns: 1fr 80px 1fr; column-gap: clamp(16px, 4vw, 60px); }
  .journey__media { position: relative; }
  .journey__frame { --fs: min(520px, calc(100vh - 220px)); position: sticky; top: calc(62px + 50vh - var(--fs) / 2); width: min(100%, var(--fs)); margin-left: auto; aspect-ratio: 1 / 1; border-radius: 28px; overflow: hidden; }
  /* Placeholder tints so the image change is visible until real photos land */
  .journey__img[data-i='1'] :global(.photo) { background: linear-gradient(200deg, var(--petal), #e9b7c9); }
  .journey__img[data-i='2'] :global(.photo) { background: linear-gradient(160deg, var(--cream), #e7c9b8); }
  .journey__img { position: absolute; inset: 0; opacity: 0; transform: scale(1.06); transition: opacity .7s ease, transform 1.2s ease; }
  .journey__img.is-active { opacity: 1; transform: scale(1); }
  .journey__img :global(.photo) { height: 100%; border-radius: 28px; }
  .journey__tag { z-index: 2; transition: opacity .3s; }
  .timeline__tag { position: absolute; top: 20px; left: 20px; padding: 8px 16px; border-radius: 999px; background: rgba(27,20,22,.35); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: #fff; font-size: 14px; font-weight: 500; }
  .journey__rail { position: relative; }
  .journey__rail::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; border-left: 2px dashed rgba(97,18,40,.3); transform: translateX(-1px); }
  .journey__fill { position: absolute; top: 0; left: 50%; width: 2px; height: calc(var(--p, 0) * 100%); background: var(--burgundy); transform: translateX(-1px); }
  .journey__dot { position: sticky; top: calc(50vh + 51px); display: block; width: 22px; height: 22px; margin: 0 auto; border-radius: 50%; background: var(--burgundy); box-shadow: 0 0 0 6px var(--cream); z-index: 1; }
  .journey__steps { list-style: none; margin: 0; padding: 0; }
  .journey__step { min-height: 78vh; display: flex; align-items: center; opacity: .3; transition: opacity .5s ease; }
  .journey__step.is-active { opacity: 1; }
  .journey__mobile-media { display: none; }
  .timeline__text { max-width: 500px; }
  .timeline__eyebrow { color: var(--burgundy); font-weight: 700; font-size: 17px; margin-bottom: 10px; }
  .timeline__text h3 { font-size: clamp(36px, 4.6vw, 60px); margin-bottom: 16px; }
  .timeline__text p:not(.timeline__eyebrow) { font-size: 17px; color: var(--ink-soft); margin-bottom: 24px; }
  .pill { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 600; font-size: 15px; text-decoration: none; transition: background .2s; }
  .pill:hover { background: var(--burgundy); }

  .quote { text-align: center; }
  .quote blockquote { font-family: var(--serif); font-size: clamp(22px, 2.6vw, 30px); line-height: 1.35; margin: 20px 0 0; color: var(--burgundy); }

  .visit { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: stretch; }
  .visit h2 { margin: 14px 0 8px; }
  .visit__lead { color: var(--ink-soft); }
  .visit__hours { display: grid; grid-template-columns: 1fr auto; margin: 24px 0 0; border-top: 1px solid var(--line); font-size: 15px; }
  .visit__hours dt, .visit__hours dd { margin: 0; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .visit__map { width: 100%; min-height: 380px; border: 0; background: var(--cream); }

  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .split, .visit { grid-template-columns: 1fr; }
    .journey { grid-template-columns: 24px 1fr; column-gap: 20px; }
    .journey__media { display: none; }
    .journey__dot { top: calc(50vh - 11px); }
    .journey__step { min-height: 0; display: block; padding-bottom: 56px; opacity: 1; }
    .journey__mobile-media { display: block; position: relative; margin-bottom: 24px; border-radius: 28px; overflow: hidden; }
    .journey__mobile-media :global(.photo) { border-radius: 28px; }
  }
  @media (max-width: 600px) {
    .hero { min-height: 560px; }
    .hero::after { background: linear-gradient(0deg, rgba(27,20,22,.65) 0%, rgba(27,20,22,.2) 60%, rgba(27,20,22,0) 100%); }
    .tiles { gap: 12px; }
    .row-head { flex-direction: column; align-items: start; }
  }
</style>
