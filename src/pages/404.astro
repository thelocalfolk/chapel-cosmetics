---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section"><div class="narrow" style="text-align:center">
    <p class="eyebrow">404</p>
    <h1 style="font-size:clamp(40px,6vw,64px);margin:12px 0 20px">This page has moved on.</h1>
    <p style="color:var(--ink-soft)">Let's get you back to something lovely.</p>
    <p style="margin-top:28px"><a class="btn" href="/">Back to home</a></p>
  </div></section>
</Base>
