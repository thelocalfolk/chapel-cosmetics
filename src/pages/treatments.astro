---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, focusAreas } from '../data/site';
---
<Base title="Treatments" description="Nurse-led cosmetic medicine at Chapel Cosmetics, Prahran, focused on skin quality, fine lines, texture and tone.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Treatments</p>
      <h1>Cosmetic medicine</h1>
      <p>Personalised, nurse-led cosmetic medicine focused on skin quality. Every treatment plan starts with a consult and is tailored to you.</p>
    </div>
  </header>

  <nav class="jump wrap" aria-label="Focus areas">
    {focusAreas.map((f) => <a href={`#${f.slug}`}>{f.title}</a>)}
  </nav>

  <section class="section">
    <div class="wrap">
      <ul class="areas">
        {focusAreas.map((f) => (
          <li id={f.slug} class="area">
            <Photo src={f.image} alt="" label={f.label} ratio="4 / 3" />
            <div class="area__text">
              <p class="eyebrow">{f.summary}</p>
              <h2>{f.title}</h2>
              <p>{f.text}</p>
              <a class="link-arrow" href={site.bookingUrl}>Book a consult</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="more" class="section section--blush">
    <div class="narrow other">
      <p class="eyebrow">Good to know</p>
      <h2>Let's talk about your skin</h2>
      <p>The Therapeutic Goods Administration does not allow the advertising of cosmetic medicine, so treatment details and pricing are discussed in consultation. Get in touch and we'll talk through what's right for you.</p>
      <div class="other__actions">
        <a class="btn" href={site.bookingUrl}>Book a consult</a>
        <a class="btn btn--ghost" href={`tel:${site.phone.replace(/\s/g, '')}`}>Call {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding-top: 24px; padding-bottom: 8px; }
  .jump a { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--line); padding: 10px 16px; border-radius: 999px; }
  .jump a:hover { border-color: var(--ink); }
  .areas { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(48px, 7vw, 96px); }
  .area { scroll-margin-top: 140px; display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .area:nth-child(even) :global(.photo) { order: 2; }
  .area :global(.photo) { border-radius: 20px; }
  .area__text { max-width: 480px; }
  .area h2 { font-size: clamp(32px, 3.6vw, 48px); margin: 8px 0 12px; }
  .area__text p:not(.eyebrow) { color: var(--ink-soft); margin-bottom: 20px; }
  .other { text-align: center; }
  .other h2 { font-size: clamp(30px, 4vw, 44px); margin: 12px 0 16px; }
  .other p:not(.eyebrow) { color: var(--ink-soft); }
  .other__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 24px; }
  @media (max-width: 760px) { .area { grid-template-columns: 1fr; gap: 20px; } .area:nth-child(even) :global(.photo) { order: 0; } }
</style>
