---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
const terms = [
  'This voucher is non-refundable and cannot be exchanged for cash in part or full.',
  'No extension of the expiry date from the date of issue will be allowed.',
  'Management may reject any voucher that has been tampered with or is otherwise unacceptable.',
  'We are not responsible if a gift voucher is lost, stolen, damaged or destroyed.',
  'Vouchers cannot be redeemed to purchase gift cards.',
];
---
<Base title="Gift cards" description="Give the gift of great skin with a Chapel Cosmetics digital gift card.">
  <section class="section">
    <div class="wrap gift">
      <div class="gift__card" aria-hidden="true">
        <Photo label="Gift card" ratio="8 / 5" />
        <span class="gift__mark">chapel cosmetics</span>
      </div>
      <div>
        <p class="eyebrow">Gift cards</p>
        <h1>Give the gift of glowing skin</h1>
        <p class="lead">A digital gift voucher, sent straight to your inbox. For a physical copy, visit us at {site.address.street}, {site.address.suburb}.</p>
        {site.giftCardUrl
          ? <a class="btn" href={site.giftCardUrl} target="_blank" rel="noopener">Buy a gift card</a>
          : <a class="btn" href="/find">Contact us to buy</a>}
        <div class="terms">
          <p class="eyebrow">Voucher terms</p>
          <ul>{terms.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .gift { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .gift__card { position: relative; box-shadow: 0 30px 60px -30px rgba(97,18,40,.45); }
  .gift__mark { position: absolute; inset: 0; display: grid; place-content: center; font-family: var(--serif); font-size: clamp(28px, 4vw, 44px); color: var(--burgundy); }
  h1 { font-size: clamp(38px, 5vw, 58px); margin: 12px 0 20px; }
  .lead { color: var(--ink-soft); margin-bottom: 28px; }
  .terms { margin-top: 40px; border-top: 1px solid var(--line); padding-top: 20px; }
  .terms ul { margin: 12px 0 0; padding-left: 1.1em; font-size: 14px; color: var(--ink-soft); }
  .terms li { margin-bottom: 6px; }
  @media (max-width: 820px) { .gift { grid-template-columns: 1fr; } }
</style>
