---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, testimonials } from '../data/site';
---
<Base title="About" description="Meet Claudia, the cosmetic nurse behind Chapel Cosmetics in Prahran.">
  <section class="section">
    <div class="wrap about">
      <Photo label="Portrait of Claudia" ratio="4 / 5" />
      <div class="about__text">
        <p class="eyebrow">About us</p>
        <h1>Meet Claudia</h1>
        <p class="lead">Claudia is an incredibly professional cosmetic nurse with an innate ability to make her clients feel safe and relaxed throughout their cosmetic procedure.</p>
        <p>Her knowledge of the scientific mechanisms behind her products, and her ability to explain them in plain language, means every client is well informed about their procedure. Alongside her professionalism and extensive product knowledge, Claudia makes each client's experience unique and enjoyable, while achieving their desired result.</p>
        <p>Chapel Cosmetics provides a unique and personable experience. This private service is tailored to you, ensuring high-quality and consistent care every visit.</p>
        <a class="btn" href={site.bookingUrl}>Book an appointment</a>
      </div>
    </div>
  </section>
  <section class="section section--blush">
    <div class="wrap">
      <p class="eyebrow">From our clients</p>
      <div class="quotes">
        {testimonials.map((t) => <blockquote>“{t}”</blockquote>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .about h1 { font-size: clamp(40px, 5vw, 64px); margin: 12px 0 24px; }
  .lead { font-family: var(--sans); font-weight: 500; letter-spacing: -0.01em; font-size: 20px; line-height: 1.4; color: var(--burgundy); }
  .about__text p:not(.eyebrow):not(.lead) { color: var(--ink-soft); }
  .about__text .btn { margin-top: 12px; }
  .quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 24px; }
  .quotes blockquote { margin: 0; font-family: var(--serif); font-size: clamp(20px, 2vw, 24px); line-height: 1.4; color: var(--burgundy); border-top: 1px solid var(--burgundy); padding-top: 24px; }
  @media (max-width: 820px) { .about, .quotes { grid-template-columns: 1fr; } }
</style>
