---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, team, testimonials } from '../data/site';
---
<Base title="About" description="Meet Claudia and Ellie, the cosmetic nurse and cosmetic injector behind Chapel Cosmetics in Prahran.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">About us</p>
      <h1>Meet the team</h1>
      <p>Chapel Cosmetics provides a unique and personable experience. This private service is tailored to you, ensuring high-quality and consistent care every visit.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap team">
      {team.map((m) => (
        <article class="member">
          <Photo src={m.photo} alt={`Portrait of ${m.name}`} label={`Portrait of ${m.name}`} ratio="4 / 5" />
          <div class="member__text">
            <p class="eyebrow">{m.role}</p>
            <h2>{m.name}</h2>
            {m.bio.map((para, i) => <p class:list={{ lead: i === 0 }}>{para}</p>)}
          </div>
        </article>
      ))}
    </div>
    <div class="wrap team__cta">
      <a class="btn" href={site.bookingUrl}>Book an appointment</a>
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap">
      <p class="eyebrow">From our clients</p>
      <div class="quotes">
        {testimonials.map((t) => <blockquote>“{t}”</blockquote>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .team { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 88px); }
  .member :global(.photo) { border-radius: 20px; }
  .member__text { padding-top: 28px; max-width: 520px; }
  .member h2 { font-size: clamp(36px, 4vw, 52px); margin: 8px 0 18px; }
  .member p:not(.eyebrow) { color: var(--ink-soft); }
  .lead { font-size: 19px; line-height: 1.5; font-weight: 500; color: var(--ink) !important; letter-spacing: -0.01em; }
  .team__cta { text-align: center; margin-top: clamp(40px, 5vw, 64px); }
  .quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 24px; }
  .quotes blockquote { margin: 0; font-family: var(--serif); font-size: clamp(20px, 2vw, 24px); line-height: 1.4; color: var(--burgundy); border-top: 1px solid var(--burgundy); padding-top: 24px; }
  @media (max-width: 820px) { .team, .quotes { grid-template-columns: 1fr; } }
</style>
