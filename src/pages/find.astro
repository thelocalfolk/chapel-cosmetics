---
import Base from '../layouts/Base.astro';
import { site, hours } from '../data/site';
---
<Base title="Find us" description="Chapel Cosmetics, 217 Chapel St, Prahran VIC 3181. Opening hours, phone and directions.">
  <header class="page-head">
    <div class="wrap"><p class="eyebrow">Contact</p><h1>Find us</h1></div>
  </header>
  <section class="section">
    <div class="wrap find">
      <div class="find__info">
        <div>
          <p class="eyebrow">Address</p>
          <p class="big">{site.address.street}<br />{site.address.suburb}, {site.address.state} {site.address.postcode}</p>
          <a class="link-arrow" href={site.mapsUrl} target="_blank" rel="noopener">Get directions</a>
        </div>
        <div>
          <p class="eyebrow">Phone</p>
          <p class="big"><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
          {site.email && <p class="big"><a href={`mailto:${site.email}`}>{site.email}</a></p>}
        </div>
        <div>
          <p class="eyebrow">Opening hours</p>
          <dl class="hours">{hours.map((h) => (<><dt>{h.day}</dt><dd>{h.time}</dd></>))}</dl>
        </div>
        <a class="btn" href={site.bookingUrl}>Book an appointment</a>
      </div>
      <iframe class="find__map" title="Map showing Chapel Cosmetics" src={site.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>
<style>
  .find { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 80px); }
  .find__info { display: grid; gap: 36px; align-content: start; }
  .find__info .btn { justify-self: start; }
  .big { font-family: var(--serif); font-size: 24px; line-height: 1.3; margin: 8px 0 12px; }
  .big a { text-decoration: none; }
  .hours { display: grid; grid-template-columns: 1fr auto; margin: 8px 0 0; max-width: 360px; }
  .hours dt, .hours dd { margin: 0; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .find__map { width: 100%; min-height: 520px; border: 0; background: var(--cream); }
  @media (max-width: 900px) { .find { grid-template-columns: 1fr; } .find__map { min-height: 360px; } }
</style>
